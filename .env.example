# ==============================================================================
# CarbonPilot Environment Configuration Template
# ==============================================================================
# Copy this file to .env in local development and fill in relevant credentials.
# Do NOT commit actual secrets or credentials to source control.

# Server & Network Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Database Configuration (MongoDB)
DATABASE_URL=mongodb://localhost:27017/carbonpilot

# Authentication (JWT)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Private document storage (hackathon limitation)
# Private document uploads currently use local filesystem storage only. S3 and
# Cloudinary configuration is not implemented or consumed by the API.

# Questionnaire assistance currently uses a deterministic mock provider.
# AI provider switching and LLM-backed extraction are not implemented.

# Logging
LOG_LEVEL=info
