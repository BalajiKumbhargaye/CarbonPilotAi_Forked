# ==============================================================================
# CarbonPilot Environment Configuration Template
# ==============================================================================
# Copy this file to .env in local development and fill in relevant credentials.
# Do NOT commit actual secrets or credentials to source control.

# Server & Network Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Database Configuration (MongoDB)
DATABASE_URL=mongodb://localhost:27017/carbonpilot

# Authentication (JWT)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# File & Object Storage Provider
# Supported providers: LOCAL | S3 | CLOUDINARY
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=./uploads

# AWS S3 Storage (Optional: if STORAGE_PROVIDER=S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Cloudinary Storage (Optional: if STORAGE_PROVIDER=CLOUDINARY)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Provider Configuration
# Supported providers: MOCK | GEMINI | OPENAI
AI_PROVIDER=MOCK
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Logging
LOG_LEVEL=info
